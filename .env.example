# Sage LLM Configuration
# Copy to .env and fill in your real values.

# --- Required for real LLM mode ---
LLM_API_KEY=your-api-key-here

# --- OpenAI-compatible (default) ---
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_MODEL=gpt-4o-mini

# --- Anthropic Claude (uncomment to use) ---
# LLM_API_URL=https://api.anthropic.com/v1/messages
# LLM_MODEL=claude-sonnet-4-20250514

# --- Other OpenAI-compatible providers ---
# OpenRouter:  LLM_API_URL=https://openrouter.ai/api/v1/chat/completions
# Together:    LLM_API_URL=https://api.together.xyz/v1/chat/completions
# Local:       LLM_API_URL=http://localhost:11434/v1/chat/completions

# Notes:
# - API format is auto-detected from LLM_API_URL (anthropic -> Anthropic
#   messages format, everything else -> OpenAI chat/completions format).
# - If LLM_API_KEY is not set, the provider runs in mock mode using
#   regex/keyword extraction (no network calls, for demos and tests).
# - Calls use a 30s timeout and 3 attempts with exponential backoff.
